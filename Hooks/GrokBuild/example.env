# Grok Build × Prisma AIRS Hooks — environment variables
# Set these in your shell profile (~/.zshrc, ~/.bashrc) on macOS/Linux, or via
# System Settings > Environment Variables (or `setx`) on Windows — in the environment Grok is
# launched from. Nothing loads this file automatically.
#
# GROK: the shipped .grok/hooks/prisma-airs.json pins AIRS_REQUIRE_CONFIG, AIRS_FAIL_MODE,
# AIRS_TIMEOUT_MS, AIRS_RETRIES and AIRS_DEADLINE_MS in each handler's "env" map, and Grok lets that
# map WIN over your shell. Change those five in prisma-airs.json, not here. Never put credentials in
# that map.

# --- Required --------------------------------------------------------------

# Prisma AIRS API key.
#   Strata Cloud Manager > AI Runtime Security > API Intercept
export PRISMA_AIRS_API_KEY="your-airs-api-key-here"

# Security profile — set ONE of these (profile_id wins if both are set).
#   Strata Cloud Manager > AI Runtime Security > Security Profiles
export PRISMA_AIRS_PROFILE_NAME="your-security-profile-name"
# export PRISMA_AIRS_PROFILE_ID="00000000-0000-0000-0000-000000000000"

# --- Optional --------------------------------------------------------------

# Regional API endpoint (base URL only — the scan path is appended for you).
# Default: US.
# export PRISMA_AIRS_URL="https://service-de.api.aisecurity.paloaltonetworks.com"  # EU (Germany)
# export PRISMA_AIRS_URL="https://service-in.api.aisecurity.paloaltonetworks.com"  # India
# export PRISMA_AIRS_URL="https://service-sg.api.aisecurity.paloaltonetworks.com"  # Singapore

# Behaviour on a *runtime* AIRS error (network down, timeout, 5xx) — a key IS set:
#   closed = block (strict; no unverified content proceeds) [DEFAULT; pinned in prisma-airs.json]
#            On Grok this covers BOTH sides: the prompt / tool call is blocked, a tool result is
#            flagged to the model (MCP output withheld), and Stop ends the turn.
#   open   = allow, log a warning (never bricks the agent; Grok never shows the warning)
# export AIRS_FAIL_MODE="closed"

# First-run policy when the install is UNCONFIGURED — no PRISMA_AIRS_API_KEY at all. Pinned to 1 in
# prisma-airs.json (fail CLOSED until a key is set); see the Grok Build README to relax it while you
# set up. A key set but NO profile is a real misconfig and always fails closed on input, regardless.
# export AIRS_REQUIRE_CONFIG="1"

# Per-scan timeout in milliseconds (default 10000) and retry count (default 1).
# export AIRS_TIMEOUT_MS="10000"
# export AIRS_RETRIES="1"

# Overall deadline for one hook run, in milliseconds (opt-in; unset = no deadline). Each AIRS
# attempt is clamped to the time left; when it runs out the scan counts as a scanner error and
# AIRS_FAIL_MODE applies (on Grok, closed blocks both sides). Keep it BELOW the hook timeout: Grok
# kills a hook at its timeout and treats the kill as ALLOW. The shipped Grok config pins 25000 (30 s
# hooks) / 55000 (60 s).
# export AIRS_DEADLINE_MS="25000"

# Oversized-content budget = AIRS_MAX_CONTENT_CHARS x AIRS_MAX_CHUNKS (default 20000 x 6 =
# 120000). The Node.js runtime scans oversized content in overlapping chunks up to this
# budget; bash/PowerShell can't chunk. Input past the budget is blocked. On Grok, output past
# the budget is scanned up to it (bash/PowerShell: the first AIRS_MAX_CONTENT_CHARS) and still
# flagged (MCP output withheld, Stop ends the turn), because the tail was never scanned. Either
# way, nothing is silently dropped.
# export AIRS_MAX_CONTENT_CHARS="20000"
# export AIRS_MAX_CHUNKS="6"

# Log file location (Grok default: $HOME/.grok/hooks/prisma-airs.log — absolute, because Grok runs
# hooks from the session workspace and a relative path would scatter logs into your repos).
# export SECURITY_LOG_PATH="/absolute/path/to/prisma-airs.log"

# Code-aware scanning (ON by default). Also sends content as code_prompt /
# code_response so AIRS runs multi-language Malicious Code Detection on tool
# input, tool output, and the model's answer (returns malicious_code). Requires
# an AIRS profile with Malicious Code Detection enabled (harmless otherwise —
# the extra fields are ignored). Set to "0" to disable.
# export AIRS_CODE_AWARE="0"

# DLP mask-in-place (opt-in; Node.js runtime only — ignored by bash/PowerShell). When "1",
# an allowed tool call/result that AIRS would DLP-mask is REDACTED in place (sensitive data
# replaced) instead of passing raw to the model. Never overrides a block; adds one scan per
# allowed tool surface. Requires an AIRS profile with basic DLP set to the Block action.
# Only tool input/output can be rewritten; prompts and the model's answer stay block-or-allow.
# export AIRS_ENABLE_MASKING="1"

# app_user reported to AIRS. Defaults per agent to "<vendor>-user" (claude-user, cursor-user,
# gemini-user, …). Override to attribute scans to a real user or team.
# export AIRS_APP_USER="alice"

# Suffix appended to the AIRS app_name for this instance. The base name is the active agent
# (Claude Code / Codex CLI / Cursor / Cline / Devin CLI / Gemini CLI / Grok Build), so a suffix of "team-a"
# reports e.g. "Codex CLI-team-a". CLAUDE_CODE_APP_SUFFIX is still honoured for back-compat.
# export AIRS_APP_SUFFIX="team-a"

# Verbose debug logging to the log file and stderr.
# export AIRS_DEBUG="1"
