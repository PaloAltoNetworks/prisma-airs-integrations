{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${USERPROFILE}/.grok/hooks/airs-hooks.ps1\" -Vendor grok -EventName UserPromptSubmit",
            "timeout": 30,
            "env": {
              "AIRS_REQUIRE_CONFIG": "1",
              "AIRS_FAIL_MODE": "closed",
              "AIRS_TIMEOUT_MS": "8000",
              "AIRS_RETRIES": "1",
              "AIRS_DEADLINE_MS": "25000"
            }
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${USERPROFILE}/.grok/hooks/airs-hooks.ps1\" -Vendor grok -EventName PreToolUse",
            "timeout": 30,
            "env": {
              "AIRS_REQUIRE_CONFIG": "1",
              "AIRS_FAIL_MODE": "closed",
              "AIRS_TIMEOUT_MS": "8000",
              "AIRS_RETRIES": "1",
              "AIRS_DEADLINE_MS": "25000"
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${USERPROFILE}/.grok/hooks/airs-hooks.ps1\" -Vendor grok -EventName PostToolUse",
            "timeout": 60,
            "env": {
              "AIRS_REQUIRE_CONFIG": "1",
              "AIRS_FAIL_MODE": "closed",
              "AIRS_TIMEOUT_MS": "8000",
              "AIRS_RETRIES": "1",
              "AIRS_DEADLINE_MS": "55000"
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${USERPROFILE}/.grok/hooks/airs-hooks.ps1\" -Vendor grok -EventName Stop",
            "timeout": 60,
            "env": {
              "AIRS_REQUIRE_CONFIG": "1",
              "AIRS_FAIL_MODE": "closed",
              "AIRS_TIMEOUT_MS": "8000",
              "AIRS_RETRIES": "1",
              "AIRS_DEADLINE_MS": "55000"
            }
          }
        ]
      }
    ]
  }
}
