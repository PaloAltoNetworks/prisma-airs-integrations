{
  "//": "Windsurf Cascade. Copy .windsurf/ into your project root. Post-hooks alert only.",
  "hooks": {
    "pre_user_prompt": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .windsurf/hooks/airs-hooks.ps1 -Vendor windsurf -EventName pre_user_prompt"
      }
    ],
    "pre_run_command": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .windsurf/hooks/airs-hooks.ps1 -Vendor windsurf -EventName pre_run_command"
      }
    ],
    "pre_mcp_tool_use": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .windsurf/hooks/airs-hooks.ps1 -Vendor windsurf -EventName pre_mcp_tool_use",
        "show_output": true
      }
    ],
    "post_mcp_tool_use": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .windsurf/hooks/airs-hooks.ps1 -Vendor windsurf -EventName post_mcp_tool_use",
        "show_output": true
      }
    ],
    "post_cascade_response": [
      {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .windsurf/hooks/airs-hooks.ps1 -Vendor windsurf -EventName post_cascade_response"
      }
    ]
  }
}
