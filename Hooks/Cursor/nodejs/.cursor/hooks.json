{
  "version": 1,
  "//": "Cursor. Copy .cursor/ into your project root. Hooks return decisions on STDOUT (permission deny / continue false).",
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/hooks.mjs --vendor cursor --event beforeSubmitPrompt",
        "timeout": 15000
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/hooks.mjs --vendor cursor --event beforeShellExecution",
        "timeout": 15000
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node .cursor/hooks/hooks.mjs --vendor cursor --event beforeMCPExecution",
        "timeout": 15000
      }
    ],
    "postToolUse": [
      {
        "command": "node .cursor/hooks/hooks.mjs --vendor cursor --event postToolUse",
        "timeout": 15000
      }
    ],
    "afterAgentResponse": [
      {
        "command": "node .cursor/hooks/hooks.mjs --vendor cursor --event afterAgentResponse",
        "timeout": 15000
      }
    ]
  }
}
