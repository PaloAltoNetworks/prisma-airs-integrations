{
  "_comment": "Google Antigravity / Gemini CLI contract. Merge this 'hooks' block into .gemini/settings.json.",
  "hooks": {
    "BeforeAgent": [
      {
        "hooks": [
          {
            "name": "prisma-airs",
            "type": "command",
            "command": "node .gemini/hooks/hooks.mjs --vendor antigravity --event BeforeAgent",
            "timeout": 15000
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "name": "prisma-airs",
            "type": "command",
            "command": "node .gemini/hooks/hooks.mjs --vendor antigravity --event BeforeTool",
            "timeout": 15000
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "name": "prisma-airs",
            "type": "command",
            "command": "node .gemini/hooks/hooks.mjs --vendor antigravity --event AfterTool",
            "timeout": 15000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "name": "prisma-airs",
            "type": "command",
            "command": "node .gemini/hooks/hooks.mjs --vendor antigravity --event AfterAgent",
            "timeout": 15000
          }
        ]
      }
    ]
  }
}
