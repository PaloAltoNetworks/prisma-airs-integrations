# Google Antigravity Prisma AIRS Security Hooks — Environment Variables
# Add these to your shell profile (~/.bashrc, ~/.zshrc, etc.) and restart
# your terminal before launching Antigravity.

# Prisma AIRS API Key (REQUIRED)
# Get this from: Strata Cloud Manager > AI Runtime Security > API Intercept
export PRISMA_AIRS_API_KEY="your-airs-api-key-here"

# Prisma AIRS Security Profile (REQUIRED — one of the two below)
# Create a profile in: Strata Cloud Manager > AI Runtime Security > Security Profiles
export PRISMA_AIRS_PROFILE_NAME="your-security-profile-name"
# export PRISMA_AIRS_PROFILE_ID="your-profile-uuid"  # Takes precedence over name

# Optional: Regional API endpoint
# Default: US  (https://service.api.aisecurity.paloaltonetworks.com)
# export PRISMA_AIRS_URL="https://service-de.api.aisecurity.paloaltonetworks.com"   # EU
# export PRISMA_AIRS_URL="https://service-in.api.aisecurity.paloaltonetworks.com"   # India
# export PRISMA_AIRS_URL="https://service-sg.api.aisecurity.paloaltonetworks.com"   # Singapore

# Optional: Custom log file path
# Default: ~/.gemini/hooks/prisma-airs.log
# export SECURITY_LOG_PATH="/custom/path/prisma-airs.log"
