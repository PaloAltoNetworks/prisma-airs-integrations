# Settings for deploy.sh. Copy this file and fill in your values:
#     cp example.env .env
#     chmod 600 .env
#     ./deploy.sh --env-file=.env
# Keep .env out of version control: it holds the Prisma AIRS key.

# --- Required --------------------------------------------------------------------------------------------------

# Google Cloud project. Also the Apigee organization unless ORG is set below.
PROJECT=your-gcp-project-id

# Apigee environment to deploy into.
ENV=eval

# The service account the SharedFlow and the example proxies run as. Apigee refuses to deploy the SharedFlow without
# one, because its log step writes to Cloud Logging. Grant it roles/logging.logWriter, and roles/aiplatform.user for
# the LLM example's calls to Vertex AI.
SA=apigee-airs@your-gcp-project-id.iam.gserviceaccount.com

# The Prisma AIRS API key (sent as x-pan-token). It is stored in an encrypted config map and read into a private
# variable, so Apigee's Debug view never shows it.
AIRS_TOKEN=your-prisma-airs-api-key

# The Prisma AIRS security profile: its name, or its UUID.
AIRS_PROFILE=your-airs-profile

# --- Optional --------------------------------------------------------------------------------------------------

# Apigee organization, if it isn't the project id.
# ORG=your-apigee-org

# Config map and SharedFlow names. Change them only if they're taken; the bundle and the examples follow.
# KVM_NAME=airs-config
# SHAREDFLOW_NAME=PANW-AIRS

# Example proxies to deploy: llm, mcp, llm,mcp, or none.
# EXAMPLES=llm
# MCP_URL=https://mcp.example.com

# Your environment group's host name, to print smoke-test commands at the end.
# APIGEE_HOST=apigee.example.com
# SMOKE_MODEL=gemini-3.8-flash

# Flow hooks (README, Flow hooks): the base paths v3 scans from the environment's hooks, each exactly as the proxy's
# base path, and their settings as a JSON object. Leave HOOK_ROUTES unset to deploy no hooks.
# HOOK_ROUTES=/airs-llm,/airs-mcp
# HOOK_SETTINGS='{"enforcementMode":"monitor"}'
