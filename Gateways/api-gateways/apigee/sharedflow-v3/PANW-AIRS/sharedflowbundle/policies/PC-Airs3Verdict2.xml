    <KeyFragment ref="airs3.vcKey2"/>
  </CacheKey>
  <Scope>Global</Scope>
  <ExpirySettings>
    <TimeoutInSec ref="airs3.vcTtl"/>
  </ExpirySettings>
  <Source>airs3.vcPut2</Source>
</PopulateCache>
