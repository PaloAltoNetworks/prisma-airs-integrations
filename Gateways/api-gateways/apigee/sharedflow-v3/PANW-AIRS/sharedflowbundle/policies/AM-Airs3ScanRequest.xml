<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The scan request is a private. message: Debug showed the key when this step set x-pan-token on a message with a plain
     name (A25), although private.airs3_token itself was hidden. -->
<AssignMessage continueOnError="false" enabled="true" name="AM-Airs3ScanRequest">
  <DisplayName>AM-Airs3ScanRequest</DisplayName>
  <AssignTo createNew="true" transport="http" type="request">private.airs3_scan</AssignTo>
  <Set>
    <Verb>POST</Verb>
    <Headers>
      <Header name="Content-Type">application/json</Header>
      <Header name="x-pan-token">{private.airs3_token}</Header>
    </Headers>
    <Payload contentType="application/json">{airs3.scanBody}</Payload>
  </Set>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
