<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Scan slot 7: a fresh, empty airs3ScanResponse7 before its call, as AM-Airs3ClearScan does for slot 1, and the
     mark that this leg ran slot 7, which JS-Airs3Verdict needs before it reads the slot's answer. -->
<AssignMessage continueOnError="false" enabled="true" name="AM-Airs3ClearScan7">
  <DisplayName>AM-Airs3ClearScan7</DisplayName>
  <AssignVariable><Name>airs3.slotRan7</Name><Value>true</Value></AssignVariable>
  <AssignTo createNew="true" transport="http" type="response">airs3ScanResponse7</AssignTo>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
