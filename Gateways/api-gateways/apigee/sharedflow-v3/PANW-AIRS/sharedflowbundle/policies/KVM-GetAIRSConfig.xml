<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The key goes only into a private. variable, which Apigee hides in Debug (A25). continueOnError=true: init refuses
     with a clear message when the key is missing. -->
<KeyValueMapOperations continueOnError="true" enabled="true" name="KVM-GetAIRSConfig" mapIdentifier="airs-config">
  <DisplayName>KVM-GetAIRSConfig</DisplayName>
  <ExpiryTimeInSecs>300</ExpiryTimeInSecs>
  <Get assignTo="private.airs3_token"><Key><Parameter>airs_token</Parameter></Key></Get>
  <Get assignTo="airs3.kvmProfile"><Key><Parameter>airs_profile</Parameter></Key></Get>
  <Get assignTo="airs3.kvmHook"><Key><Parameter>airs_hook</Parameter></Key></Get>
  <Scope>environment</Scope>
</KeyValueMapOperations>
