<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- v3: continueOnError=true with a done flag, so a step that does not finish
     is refused in the client's format, never with Apigee's bare 500 (L2). -->
<Javascript continueOnError="true" enabled="true" timeLimit="10000" name="JS-Airs3Restream">
  <DisplayName>JS-Airs3Restream</DisplayName>
  <IncludeURL>jsc://airs3-lib.js</IncludeURL>
  <IncludeURL>jsc://airs3-fmt-openai-chat.js</IncludeURL>
  <IncludeURL>jsc://airs3-fmt-openai-responses.js</IncludeURL>
  <IncludeURL>jsc://airs3-fmt-anthropic.js</IncludeURL>
  <IncludeURL>jsc://airs3-fmt-gemini.js</IncludeURL>
  <IncludeURL>jsc://airs3-fmt-mcp.js</IncludeURL>
  <ResourceURL>jsc://airs3-restream.js</ResourceURL>
</Javascript>
