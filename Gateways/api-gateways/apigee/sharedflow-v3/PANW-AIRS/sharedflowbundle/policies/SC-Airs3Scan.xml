<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Strict certificate checks (A26): with no SSLInfo, Apigee accepted a self-signed certificate (L5).
     continueOnError=true: the verdict step reads the status, or its absence, and decides (L10). -->
<ServiceCallout continueOnError="true" enabled="true" name="SC-Airs3Scan">
  <DisplayName>SC-Airs3Scan</DisplayName>
  <Request clearPayload="false" variable="private.airs3_scan">
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
  </Request>
  <Response>airs3ScanResponse</Response>
  <Timeout>5000</Timeout>
  <HTTPTargetConnection>
    <SSLInfo><Enabled>true</Enabled><Enforce>true</Enforce></SSLInfo>
    <URL>https://{airs3.endpoint}/v1/scan/sync/request</URL>
  </HTTPTargetConnection>
</ServiceCallout>
