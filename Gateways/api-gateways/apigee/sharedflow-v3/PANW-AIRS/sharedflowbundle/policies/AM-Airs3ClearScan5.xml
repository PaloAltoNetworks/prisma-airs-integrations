<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Scan slot 5: a fresh, empty airs3ScanResponse5 before its call, as AM-Airs3ClearScan does for slot 1, and the
     mark that this leg ran slot 5, which JS-Airs3Verdict needs before it reads the slot's answer. -->
<AssignMessage continueOnError="false" enabled="true" name="AM-Airs3ClearScan5">
  <DisplayName>AM-Airs3ClearScan5</DisplayName>
  <AssignVariable><Name>airs3.slotRan5</Name><Value>true</Value></AssignVariable>
  <AssignTo createNew="true" transport="http" type="response">airs3ScanResponse5</AssignTo>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
