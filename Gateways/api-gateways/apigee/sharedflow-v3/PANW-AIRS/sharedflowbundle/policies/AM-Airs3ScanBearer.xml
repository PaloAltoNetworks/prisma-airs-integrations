<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- v3.1, bearer mode: the scan request as AM-Airs3ScanRequest builds it, a private. message (A25, L23), with the OAuth
     token as Authorization: Bearer and no x-pan-token, so each call carries one credential (Prisma AIRS answers 403 to a
     token beside a wrong key). Its step's condition is the exact opposite of AM-Airs3ScanRequest's. -->
<AssignMessage continueOnError="false" enabled="true" name="AM-Airs3ScanBearer">
  <DisplayName>AM-Airs3ScanBearer</DisplayName>
  <AssignTo createNew="true" transport="http" type="request">private.airs3_scan</AssignTo>
  <Set>
    <Verb>POST</Verb>
    <Headers>
      <Header name="Content-Type">application/json</Header>
      <Header name="Authorization">Bearer {private.airs3_bearer}</Header>
    </Headers>
    <Payload contentType="application/json">{airs3.scanBody}</Payload>
  </Set>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
