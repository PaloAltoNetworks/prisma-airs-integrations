<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Scan slot 4: a fresh, empty airs3ScanResponse4 before its call, as AM-Airs3ClearScan does for slot 1, and the
     mark that this leg ran slot 4, which JS-Airs3Verdict needs before it reads the slot's answer. -->
<AssignMessage continueOnError="false" enabled="true" name="AM-Airs3ClearScan4">
  <DisplayName>AM-Airs3ClearScan4</DisplayName>
  <AssignVariable><Name>airs3.slotRan4</Name><Value>true</Value></AssignVariable>
  <AssignTo createNew="true" transport="http" type="response">airs3ScanResponse4</AssignTo>
  <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
</AssignMessage>
